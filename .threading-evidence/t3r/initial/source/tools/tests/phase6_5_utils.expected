# Focused native libc utility gate: echo, pwd, cat, and directory re-entry.
# Phase 2B.2 adds head, cmp, cksum.
# Phase 2B.3 adds wc, cut, fold, expand.
[TTY]  cmd: /bin/pwd -> /\n
[TTY]  exit: /bin/pwd -> 0
[TTY]  cmd: echo -> \n
[TTY]  exit: echo -> 0
[TTY]  cmd: echo hi -> hi\n
[TTY]  exit: echo hi -> 0
[TTY]  cmd: echo hello world -> hello world\n
[TTY]  exit: echo hello world -> 0
[TTY]  cmd: /bin/pwd -> /root\n
[TTY]  exit: /bin/pwd -> 0
[TTY]  exit: mkdir New -> 0
[TTY]  cmd: ls -> a.txt\n
[TTY]  exit: ls -> 0
[TTY]  cmd: /bin/pwd -> /root/New\n
[TTY]  exit: /bin/pwd -> 0
[TTY]  exit: touch a.txt -> 0
[TTY]  exit: ls -> 0
[TTY]  exit: cat /tests/cat-empty -> 0
[TTY]  cmd: cat /tests/cat-hello -> hello from cat\n
[TTY]  exit: cat /tests/cat-hello -> 0
[TTY]  cmd: cat ../../tests/cat-nonewline -> nonewline
[TTY]  exit: cat ../../tests/cat-nonewline -> 0
[TTY]  exit: cat /tests/cat-big -> 0
[TTY]  exit: cat /tests/missing -> 1
# Phase 2B.2: head, cmp, cksum
[TTY]  exit: head /tests/ho -> 0
[TTY]  exit: head -n 2 /tests/hm -> 0
[TTY]  exit: cmp /tests/ia /tests/ib -> 0
[TTY]  exit: cmp -s /tests/da /tests/db -> 1
[TTY]  exit: cksum /tests/ho -> 0
# Phase 2B.3: wc, cut, fold, expand
[TTY]  exit: wc /tests/wc-empty -> 0
[TTY]  exit: wc -l /tests/wc-text -> 0
[TTY]  exit: cut -f 2 -d : /tests/cut-delim -> 0
[TTY]  exit: cut -b 2-4 /tests/cut-bytes -> 0
[TTY]  exit: fold -w 10 /tests/fold-long -> 0
[TTY]  exit: expand /tests/expand-tabs -> 0