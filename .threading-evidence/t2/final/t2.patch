+                    && p.service_reap_watcher.is_none()
+                    && p.owning_core == u8::MAX
+                    && p.queued_on_core == u8::MAX
+                    && !self.stack_is_pinned(*idx)
+                    && (0..self.online_cores).all(|cpu| self.core_current_task(cpu) != Some(*idx))
+            })
+            .map(|(idx, _)| idx)
+            .unwrap_or(self.processes.len());
