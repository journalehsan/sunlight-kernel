+        let mut vm = 0usize;
+        for p in &self.processes {
+            if !p.owns_address_space && p.state != ProcessState::Reaped {
+                global = global.checked_add(1).ok_or(Error::Capacity)?;
+                if p.address_space.identity() == identity {
+                    vm = vm.checked_add(1).ok_or(Error::Capacity)?;
