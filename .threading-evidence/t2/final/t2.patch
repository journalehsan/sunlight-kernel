+/* Authenticated by the debug kernel's immutable ELF loader/VM registration.
+ * Every userspace loop has a finite iteration bound; host has a guest deadline.
+ * Deliberately uses small, distinct mapped stacks; never stresses the host. */
+.global _start
+.section .text
+.macro query label, length
+.ifdef LINUX
+    movabs $0x8000000000000063, %rax
+.else
+    mov $99, %eax
+.endif
+    lea \label(%rip), %rdi
+    mov $\length, %esi
+    syscall
+.endm
+.macro yield
+.ifdef LINUX
+    mov $24, %eax
+.else
+    mov $21, %eax
+.endif
+    syscall
+.endm
+_start:
+    mov %rdi, %r12                  /* immutable owner role */
+    mov $200000, %ebp
+wait_my_phase:
+    query phase, 8
+    cmp $3, %r12d
+    je observer
+    cmp $2, %r12d
+    je wait_pressure
+    cmp %r12, %rax
+    je fault_test
+    yield
+    dec %ebp
+    jnz wait_my_phase
+    jmp failed
+fault_test:
+    /* Warm all bounded scheduler storage before exact heap comparisons. */
+    xor %r15d, %r15d
+    call spawn
+    test %rax, %rax
+    js failed
+    call quiescent
+    mov $1, %r14d
+fault_loop:
+    mov %r14d, %eax
+    xor %edx, %edx
+    mov $10, %ecx
+    div %ecx
+    add $48, %dl
+    mov %dl, arm+9(%rip)
+    xor %edx, %edx
+    div %ecx
