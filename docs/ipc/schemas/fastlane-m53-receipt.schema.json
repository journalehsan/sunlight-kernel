{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sunlight:fastlane:m53:receipt:v1",
  "title": "M5.3 native correctness and measurement-readiness receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "milestone", "status", "errors", "source_identity", "image_identity", "cpu_topology", "workload", "actors", "latency_samples", "kernel_actors", "setup", "retirement", "clock_probes", "timing", "unavailable_metrics", "system_diagnostics", "expected_adversarial_outcomes", "integrity", "final_inventory", "m6_decision"],
  "properties": {
    "schema": {"const": "sunlight.fastlane.measurement-readiness.v1"},
    "milestone": {"const": "M5.3"},
    "status": {"enum": ["PASS", "FAIL"]},
    "errors": {"type": "array", "maxItems": 128, "items": {"type": "string"}},
    "source_identity": {"$ref": "#/$defs/hash"},
    "image_identity": {"type": "object", "additionalProperties": false, "required": ["elf_sha256", "iso_sha256"], "properties": {"elf_sha256": {"$ref": "#/$defs/hash"}, "iso_sha256": {"$ref": "#/$defs/hash"}}},
    "cpu_topology": {"type": "object", "required": ["online", "producer_affinity", "consumer_affinity", "clock_probe_cpus"], "properties": {"online": {"enum": [2,4,12]}, "producer_affinity": {"const": 0}, "consumer_affinity": {"const": 1}, "clock_probe_cpus": {"const": [0,1]}}},
    "workload": {"type": "object"},
    "actors": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"$ref": "#/$defs/actor"}},
    "latency_samples": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/row"}},
    "kernel_actors": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"$ref": "#/$defs/kernelActor"}},
    "setup": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/row"}},
    "retirement": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/row"}},
    "clock_probes": {"type": "array", "minItems": 16, "maxItems": 16, "items": {"$ref": "#/$defs/row"}},
    "timing": {"type": "object", "required": ["source", "resolution_ms", "valid_for_elapsed_windows", "valid_for_per_message_percentiles", "overhead", "zero_duration", "tsc_cross_cpu_validation"], "properties": {"source": {"const": "kernel-bsp-ms"}, "resolution_ms": {"const": 10}, "valid_for_elapsed_windows": {"type": "boolean"}, "valid_for_per_message_percentiles": {"const": false}, "zero_duration": {"const": "INVALID_FOR_RATES"}, "tsc_cross_cpu_validation": {"const": "NOT_CLAIMED"}}},
    "unavailable_metrics": {"type": "array", "maxItems": 32, "items": {"type": "string"}},
    "system_diagnostics": {"type": "array", "maxItems": 4, "items": {"$ref": "#/$defs/row"}},
    "expected_adversarial_outcomes": {"type": "object"},
    "integrity": {"type": "object", "required": ["memory_safety", "stable_private_snapshots", "coherent_publication", "application_authenticity"], "properties": {"memory_safety": {"const": "PROVIDED"}, "stable_private_snapshots": {"const": "PROVIDED"}, "coherent_publication": {"const": "NOT PROVIDED"}, "application_authenticity": {"const": "NOT PROVIDED"}}},
    "final_inventory": {"type": "object", "required": ["restricted", "doorbell"], "properties": {"restricted": {"type": "array", "minItems": 1, "maxItems": 1}, "doorbell": {"type": "array", "minItems": 1, "maxItems": 1}}},
    "m6_decision": {"type": "string", "pattern": "^NOT_READY:"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "row": {"type": "object", "maxProperties": 24, "additionalProperties": {"type": "string", "maxLength": 4096}},
    "actor": {"allOf": [{"$ref": "#/$defs/row"}, {"required": ["generation", "pid", "start_sequence", "next", "count", "bytes", "full", "overflow", "dropped", "sample_count", "order", "start_ms", "end_ms", "clock", "resolution_ms", "coherent", "authentic"]}]},
    "kernelActor": {"allOf": [{"$ref": "#/$defs/row"}, {"required": ["generation", "pid", "inc", "vm", "syscalls", "notifications", "context_switch_ins", "wake_publications", "overflow", "dropped", "start_ms", "end_ms", "scheduler_runtime_ns", "runtime_delta_valid", "cpu"]}]}
  },
  "$comment": "Maximum encoded receipt size 65536 bytes. fastlane_m53_receipt.validate enforces native identity joins, exact counts/bytes/order, terminal outcomes and timing. JSON Schema validates structure only. Workload is separately validated against fastlane-m53-workload.schema.json."
}
