[bundle]
format = 1

[application]
id = "org.sunlight.chronos.dn151.diagnostic"
name = "DOS Navigator 1.51 (Compatibility Diagnostic)"
version = "1.51.0"
kind = "terminal-window"
icon = "Resources/icon.tga"

[runtime]
type = "chronos"

[entry]
executable = "C:\\DN.COM"
working_directory = "C:\\"
arguments = []

[chronos]
cpu = "80286"
memory_kb = 640
code_page = 437

[storage]
c_base = ["Program"]
c_overlay = "persistent"
d_scope = "none"
t_drive = "temporary"

[permissions]
documents = "none"
clipboard = false
printing = false
serial = false
network = false

[window]
default_width = 1000
default_height = 720
resizable = true

