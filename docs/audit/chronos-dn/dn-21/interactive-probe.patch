+fn snapshot(r: &Runtime) {
+    let p = r.current_psp();
+    let env = r.memory.read_u16(p, 0x2c);
+    let len = r.memory.read_u8(p, 0x80).min(126);
+    let tail = (0..=u16::from(len)).map(|i| r.memory.read_u8(p, 0x81+i)).collect::<Vec<_>>();
+    let env_bytes = (0..160).map(|i| r.memory.read_u8(env, i)).collect::<Vec<_>>();
+    let end = env_bytes.windows(2).position(|w| w == [0,0]).map(|i| i+2).unwrap_or(160);
+    let mut checksum = 0xcbf29ce484222325u64;
+    for row in 0..25 {
+        for col in 0..80 {
+            let c = r.cell(col,row);
+            for b in [c.character, c.attribute] {
+                checksum = (checksum ^ u64::from(b)).wrapping_mul(0x100000001b3);
+            }
+        }
+    }
+    println!("SNAP retired={} PSP={p:04x} parent={:04x} env={env:04x} env_vars={:?} tail_len={len} tail={tail:02x?} cursor={},{} shape={:04x} cells={checksum:016x} queue={} state={:?} CPU={:04x?}", r.instructions_retired(), r.memory.read_u16(p,0x16), String::from_utf8_lossy(&env_bytes[..end]), r.cursor_column(), r.cursor_row(), r.cursor_shape(), r.queued_key_count(), r.state(), r.cpu);
+}
