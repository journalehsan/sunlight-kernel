+static void *sfs5b6_private_access(void *opaque)
+{
+    VirtIOBlockReq *req = opaque;
+    volatile unsigned char *payload = req->qiov.iov[0].iov_base;
+    unsigned char observed;
+    while (true) {
+        qemu_mutex_lock(&sfs5b6_private_lock);
+        if (sfs5b6_private_stop) {
+            qemu_mutex_unlock(&sfs5b6_private_lock);
+            break;
+        }
+        observed = *payload;
+        sfs5b6_private_reads++;
+        if (sfs5b6_private_drained && !sfs5b6_private_observed) {
+            sfs5b6_private_observed = true;
+            fprintf(stderr, "SFS5B6 PRIVATE_OBSERVED_DRAIN req=%p reads=%" PRIu64 "\n",
+                    req, sfs5b6_private_reads);
+        }
+        qemu_mutex_unlock(&sfs5b6_private_lock);
+        assert(observed == 0xb4);
+        g_usleep(100);
+    }
+    fprintf(stderr, "SFS5B6 PRIVATE_EXIT req=%p reads=%" PRIu64 "\n",
+            req, sfs5b6_private_reads);
+    return NULL;
+}
+
+static void sfs5b6_complete(void *opaque, int ret)
+{
+    VirtIOBlockReq *req = opaque;
+    assert(req == sfs5b6_request && !sfs5b6_terminal);
+    sfs5b6_terminal = true;
+    sfs5b6_result = ret;
+    fprintf(stderr, "SFS5B6 DEVICE_CALLBACK req=%p head=%u ret=%d mapping=retained\n",
+            req, req->elem.index, ret);
+}
