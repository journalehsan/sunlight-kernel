+static int coroutine_fn sfs5b6_backend_hold(BlockBackend *blk, int64_t offset,
+                                           int64_t bytes, QEMUIOVector *qiov)
+{
+    const char *test_case = getenv("SFS5B6_CASE");
+    if (!getenv("SFS5B6_BACKEND") || offset != 63 * 512 || bytes != 512 ||
+        strcmp(blk_name(blk), "sfs5b5")) {
+        return 0;
+    }
+    sfs5b6_drain_entered = false;
+    fprintf(stderr, "SFS5B6 BACKEND_ADMITTED qiov=%p inflight=%u node_inflight=%u\n",
+            qiov, qatomic_read(&blk->in_flight),
+            qatomic_read(&blk_bs(blk)->in_flight));
+    if (!test_case || strcmp(test_case, "before")) {
+        while (!sfs5b6_drain_entered) {
+            qemu_co_sleep_ns(QEMU_CLOCK_REALTIME, 1000000);
+        }
+        qemu_co_sleep_ns(QEMU_CLOCK_REALTIME, 20000000);
+    }
+    if (test_case && !strcmp(test_case, "indefinite")) {
+        while (true) {
+            qemu_co_sleep_ns(QEMU_CLOCK_REALTIME, 100000000);
+        }
+    }
+    fprintf(stderr, "SFS5B6 BACKEND_RELEASE qiov=%p inflight=%u\n",
+            qiov, qatomic_read(&blk->in_flight));
+    return test_case && !strcmp(test_case, "error") ? -EIO : 0;
+}
