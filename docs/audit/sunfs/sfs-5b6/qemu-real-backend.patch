+static void sfs5b6_reset(VirtIOBlock *s)
+{
+    VirtIOBlockReq *req = sfs5b6_request;
+    assert(bql_locked());
+    fprintf(stderr, "SFS5B6 DRAIN_BEGIN req=%p terminal=%d\n", req, sfs5b6_terminal);
+    if (!sfs5b6_terminal && getenv("SFS5B6_CASE") &&
+        !strcmp(getenv("SFS5B6_CASE"), "cancel")) {
+        fprintf(stderr, "SFS5B6 CANCEL_REQUEST req=%p\n", req);
+        blk_aio_cancel_async(sfs5b6_acb);
+        fprintf(stderr, "SFS5B6 CANCEL_RETURN req=%p terminal=%d\n", req, sfs5b6_terminal);
+    }
+    blk_drain(s->blk);
+    fprintf(stderr, "SFS5B6 DRAIN_END req=%p terminal=%d\n", req, sfs5b6_terminal);
+    assert(sfs5b6_terminal);
+    if (sfs5b6_private_started) {
+        unsigned waited;
+        qemu_mutex_lock(&sfs5b6_private_lock);
+        sfs5b6_private_drained = true;
+        qemu_mutex_unlock(&sfs5b6_private_lock);
+        for (waited = 0; waited < 2000; waited++) {
+            bool observed;
+            qemu_mutex_lock(&sfs5b6_private_lock);
+            observed = sfs5b6_private_observed;
+            qemu_mutex_unlock(&sfs5b6_private_lock);
+            if (observed) {
+                break;
+            }
+            g_usleep(1000);
+        }
+        assert(waited < 2000);
+        qemu_mutex_lock(&sfs5b6_private_lock);
+        fprintf(stderr, "SFS5B6 PRIVATE_ACTIVE_AFTER_DRAIN req=%p reads=%" PRIu64 "\n",
+                req, sfs5b6_private_reads);
+        sfs5b6_private_stop = true;
+        qemu_mutex_unlock(&sfs5b6_private_lock);
+        qemu_thread_join(&sfs5b6_private_thread);
+        fprintf(stderr, "SFS5B6 PRIVATE_JOINED req=%p\n", req);
+        sfs5b6_private_started = false;
+        qemu_mutex_destroy(&sfs5b6_private_lock);
+    }
+    iov_discard_undo(&req->inhdr_undo);
+    iov_discard_undo(&req->outhdr_undo);
+    virtqueue_detach_element(req->vq, &req->elem, 0);
+    if (sfs5b6_result) {
+        block_acct_failed(blk_get_stats(s->blk), &req->acct);
+    } else {
+        block_acct_done(blk_get_stats(s->blk), &req->acct);
+    }
+    fprintf(stderr, "SFS5B6 MAPPING_RELEASED req=%p head=%u used=not-published\n",
+            req, req->elem.index);
+    sfs5b6_request = NULL;
+    g_free(req);
+}
