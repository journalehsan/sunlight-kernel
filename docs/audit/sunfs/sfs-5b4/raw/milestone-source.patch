+                        event(role, actor, "RESET_REQUESTED");
+                    }
+                }
+                let step = if CANCEL.load(Ordering::Acquire) && at_owner {
+                    c.cancel(ticket)
+                } else {
+                    unsafe { c.step(ticket) }
+                };
