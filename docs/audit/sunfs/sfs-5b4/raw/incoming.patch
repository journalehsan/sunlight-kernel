+        let result = unsafe { d.flush_typed() };
+        assert_eq!(result.completion, Completion::Unsupported);
+        assert_eq!(result.request, None);
+        assert_eq!(result.completed, Amount::Exact(0));
+        assert!(q.0 == before);
+    }
+    #[test]
+    fn t9_failed_flush_preserves_write_uncertainty() {
