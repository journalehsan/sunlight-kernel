+/* SFS5B3 TEST ONLY: one disposable attachment, one real OUT sector.  This
+ * splits consumption of its actual data descriptor, before backend submission.
+ * BQL/main AioContext only; launch MUST use ioeventfd=off and no IOThread.
+ * It is not a host request mock and not an assertion of simultaneous bus DMA.
+ */
+static VirtIOBlockReq *sfs5b3_held;
+static void *sfs5b3_old_data;
+static VirtIODevice *sfs5b3_old_device;
+static QEMUTimer *sfs5b3_timer;
+static unsigned char sfs5b3_data[512];
+static QEMUIOVector sfs5b3_guest;
+static struct iovec sfs5b3_iov;
+static uint64_t sfs5b4_seq;
+static unsigned sfs5b4_budget;
+static unsigned sfs5b4_head;
+static bool sfs5b4_fenced;
+static QEMUTimer *sfs5b4_late;
+static void sfs5b4_event(const char *stage, unsigned bytes)
+{
+    assert(bql_locked());
+    fprintf(stderr, "SFS5B4 seq=%" PRIu64 " ns=%" PRId64 " epoch=1 queue=0 head=%u stage=%s bytes=%u\n",
+            ++sfs5b4_seq, qemu_clock_get_ns(QEMU_CLOCK_REALTIME),
+            sfs5b4_head, stage, bytes);
+}
+static void sfs5b4_late_observer(void *opaque)
+{
+    /* Scalar-only observer. No request or guest pointer survives teardown. */
+    assert(sfs5b4_fenced);
+    sfs5b4_event("LATE_CALLBACK_NO_REQUEST", 0);
+    sfs5b4_event("STALE_ACCESS_REJECTED", 0);
+}
+
+
+static void sfs5b3_done(void *opaque, int ret)
+{
+    VirtIOBlockReq *req = opaque;
+    fprintf(stderr, "SFS5B3 backend-complete head=%u ret=%d\n", req->elem.index, ret);
+    virtio_blk_rw_complete(opaque, ret);
+}
+
+static void sfs5b3_release(void *opaque)
+{
+    const char *release = getenv("SFS5B3_RELEASE");
+    VirtIOBlockReq *req = sfs5b3_held;
+    if (!req) {
+        return;
+    }
+    if (!release || access(release, F_OK)) {
+        if (++sfs5b4_budget == 3000) {
+            sfs5b4_event("BARRIER_EXPIRED_RETAINED", 0);
+            return; /* held until reset or process termination; no rearming */
+        }
+        timer_mod(sfs5b3_timer, qemu_clock_get_ms(QEMU_CLOCK_REALTIME) + 10);
+        return;
+    }
+    assert(bql_locked());
+    sfs5b4_event("PAYLOAD_ACCESS_STARTED", 0);
+    assert(qemu_iovec_to_buf(&sfs5b3_guest, 256, sfs5b3_data + 256, 256) == 256);
+    fprintf(stderr, "SFS5B3 dma-read head=%u offset=256 bytes=256 value=%u\n",
+            req->elem.index, sfs5b3_data[256]);
+    sfs5b4_event("PAYLOAD_ACCESS_ENDED", 256);
+    sfs5b3_held = NULL;
+    sfs5b3_iov.iov_base = sfs5b3_data;
+    sfs5b3_iov.iov_len = 512;
+    qemu_iovec_init_external(&req->qiov, &sfs5b3_iov, 1);
+    fprintf(stderr, "SFS5B3 backend-submit head=%u\n", req->elem.index);
+    blk_aio_pwritev(req->dev->blk, req->sector_num << BDRV_SECTOR_BITS,
+                   &req->qiov, 0, sfs5b3_done, req);
+}
+
+
+/* Called after generic queue reset. The five-page geometry is an explicit
+ * contract of this disposable guest fixture, never inferred for normal devices.
+ * Protect original direct RAM mappings until process death; no recovery/reuse.
+ */
+void sfs5b3_guard_old_dma(VirtIODevice *vdev, void *queue_host);
+void sfs5b3_guard_old_dma(VirtIODevice *vdev, void *queue_host)
+{
+    uintptr_t data_page;
+    int fds[2];
+    ssize_t probe;
+    if (sfs5b3_old_device != vdev || !sfs5b3_old_data) {
+        return;
+    }
+    assert(bql_locked());
+    assert(queue_host && !((uintptr_t)queue_host & 4095));
+    data_page = (uintptr_t)sfs5b3_old_data & ~(uintptr_t)4095;
+    assert((uintptr_t)queue_host + 16384 <= data_page ||
+           data_page + 4096 <= (uintptr_t)queue_host);
+    sfs5b4_fenced = true;
+    sfs5b4_event("RESET_ACKNOWLEDGED", 0);
+    if (!strcmp(getenv("SFS5B3_MODE"), "negative")) {
+        /* Deliberately broken TEST model: original stable RAM still pinned.
+         * Kernel pipe-copy safely witnesses a real illegal post-fence read.
+         * No physical DMA or hostile alias-containment claim. */
+        assert(pipe2(fds, O_NONBLOCK | O_CLOEXEC) == 0);
+        assert(write(fds[1], sfs5b3_old_data, 1) == 1);
+        close(fds[0]); close(fds[1]);
+        sfs5b4_event("ILLEGAL_POST_FENCE_ACCESS", 1);
+    }
+    if (!sfs5b4_late) {
+        sfs5b4_late = timer_new_ms(QEMU_CLOCK_REALTIME, sfs5b4_late_observer, NULL);
+    }
+    timer_mod(sfs5b4_late, qemu_clock_get_ms(QEMU_CLOCK_REALTIME) + 20);
+    assert(pipe2(fds, O_NONBLOCK | O_CLOEXEC) == 0);
+    /* Positive control: kernel can read the original payload before protection. */
+    assert(write(fds[1], sfs5b3_old_data, 1) == 1);
+    assert(mprotect(queue_host, 16384, PROT_NONE) == 0);
+    assert(mprotect((void *)data_page, 4096, PROT_NONE) == 0);
+    for (unsigned i = 0; i < 5; i++) {
+        void *page = i < 4 ? (char *)queue_host + i * 4096 : (void *)data_page;
+        errno = 0;
+        probe = write(fds[1], page, 1);
+        assert(probe == -1 && errno == EFAULT);
+    }
+    close(fds[0]);
+    close(fds[1]);
+    fprintf(stderr, "SFS5B3 guard-installed queue=%p queue-bytes=16384 request=%p request-bytes=4096 probe=EFAULT\n",
+            queue_host, (void *)data_page);
+    sfs5b4_event("ORIGINAL_MAPPINGS_PROTECTED", 0);
+    sfs5b3_old_data = NULL;
+    sfs5b3_old_device = NULL;
+}
+
+static bool sfs5b3_hold(VirtIOBlockReq *req, bool is_write)
+{
+    const char *mode = getenv("SFS5B3_MODE");
+    VirtIOBlock *s = req->dev;
+    if (!mode || !s->conf.serial || strcmp(s->conf.serial, "SFS5B3-disposable") ||
+        !is_write || req->sector_num != 63 || req->qiov.size != 512) {
+        return false;
+    }
+    assert(bql_locked());
+    assert(!sfs5b3_held);
+    sfs5b4_head = req->elem.index;
+    sfs5b4_fenced = false;
+    sfs5b4_budget = 0;
+    sfs5b4_event("DEVICE_FETCHED", 0);
+    sfs5b3_guest = req->qiov;
+    sfs5b4_event("PAYLOAD_ACCESS_STARTED", 0);
+    fprintf(stderr, "SFS5B3 fetched queue=0 head=%u sector=63 bytes=512 guest=%p mode=%s\n",
+            req->elem.index, req->qiov.iov[0].iov_base, mode);
+    assert(qemu_iovec_to_buf(&sfs5b3_guest, 0, sfs5b3_data, 256) == 256);
+    fprintf(stderr, "SFS5B3 dma-read head=%u offset=0 bytes=256 value=%u\n",
+            req->elem.index, sfs5b3_data[0]);
+    sfs5b4_event("PAYLOAD_ACCESS_ENDED", 256);
+    sfs5b3_held = req;
+    sfs5b4_event("REQUEST_OUTSTANDING", 0);
+    if (!sfs5b3_timer) {
+        sfs5b3_timer = timer_new_ms(QEMU_CLOCK_REALTIME, sfs5b3_release, NULL);
+    }
+    timer_mod(sfs5b3_timer, qemu_clock_get_ms(QEMU_CLOCK_REALTIME) + 10);
+    fprintf(stderr, "SFS5B3 held head=%u consumed=256 remaining=256 backend=not-submitted used=not-published\n",
+            req->elem.index);
+    return true;
+}
