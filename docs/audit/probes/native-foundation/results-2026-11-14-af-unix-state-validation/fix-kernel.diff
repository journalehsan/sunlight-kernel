+/// A registration is keyed by fd number, so it cannot survive a descriptor
+/// replacement: it would report the readiness of whatever object the number
+/// was rebound to, under the old registration token and `event.data`. With a
+/// userspace transport attachment that still names the replaced endpoint, it
+/// would even deliver the replaced endpoint's readiness. Descriptor
+/// replacement therefore ends the target's registrations, exactly as close
+/// does. Validation mirrors `FdTable::dup2`, so an invalid source, an invalid
+/// target or `old_fd == new_fd` leaves the target untouched.
+fn invalidate_replaced_fd(process: &crate::process::Process, old_fd: i32, new_fd: i32) {
+    if old_fd == new_fd || !(0..256).contains(&new_fd) {
+        return;
+    }
+    if process.fd_table.get(old_fd).is_none() {
+        return;
+    }
+    crate::process::epoll::detach_fd(new_fd, process);
+}
