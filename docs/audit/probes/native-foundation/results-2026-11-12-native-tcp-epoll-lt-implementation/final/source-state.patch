+/// Native-only bridge. No user pointer is used while holding SCHEDULER.
+/// mode 0 snapshots all external interests; mode 1 merges observations with
+/// local readiness; mode 2 installs an external identity through ordinary ctl.
+fn sys_native_epoll_bridge(frame: &mut SyscallFrame) -> u64 {
+    use crate::process::epoll::{self, ExternalObservation};
+    let mode = frame.r9 & 0xff;
+    if mode > 3 || (mode != 2 && frame.r9 != mode) {
+        return linux_errno(22);
+    }
+    if mode == 3 {
+        let sched = crate::sched::SCHEDULER.lock();
+        let Some(entry) = sched
+            .current_shared_process()
+            .fd_table
+            .get(frame.rdi as i32)
+        else {
+            return linux_errno(9);
+        };
+        return if entry.handle.is_inet_socket() {
+            crate::process::inet_socket::generation(entry.handle.inet_socket_index())
+        } else {
+            0
+        };
+    }
+    if mode == 2 {
+        return epoll_ctl_impl_external(
+            frame,
+            false,
+            (frame.r8 != u64::MAX).then_some(frame.r8),
+            true,
+        );
+    }
+    let count = frame.rdx as usize;
+    if count > 64 || (mode == 0 && count != 64) || (mode == 1 && (frame.r8 == 0 || frame.r8 > 128))
+    {
+        return linux_errno(22);
+    }
+    let mut observations = alloc::vec![ExternalObservation::default(); count];
+    if mode == 1 && count != 0 {
+        let bytes = unsafe {
+            core::slice::from_raw_parts_mut(observations.as_mut_ptr() as *mut u8, count * 32)
+        };
+        if crate::memory::user::copy_from_current(frame.rsi, bytes).is_err() {
+            return linux_errno(14);
+        }
+        if observations
+            .iter()
+            .any(|o| o.reserved != 0 || o.ready & !0x1d != 0)
+        {
+            return linux_errno(22);
+        }
+    }
+    let sched = crate::sched::SCHEDULER.lock();
+    let Some(entry) = sched
+        .current_shared_process()
+        .fd_table
+        .get(frame.rdi as i32)
+    else {
+        return linux_errno(9);
+    };
+    if !entry.handle.is_epoll() {
+        return linux_errno(9);
+    }
+    let idx = entry.handle.epoll_index();
+    if mode == 0 {
+        let snapshot = match epoll::external_snapshot(idx, sched.current_shared_process()) {
+            Ok(s) => s,
+            Err(e) => return linux_errno(e.to_linux_errno()),
+        };
+        drop(sched);
+        let bytes = unsafe {
+            core::slice::from_raw_parts(snapshot.as_ptr() as *const u8, snapshot.len() * 32)
+        };
+        if !bytes.is_empty() && crate::memory::user::copy_to_current(frame.rsi, bytes).is_err() {
+            return linux_errno(14);
+        }
+        return snapshot.len() as u64;
+    }
+    let ready = match epoll::collect_ready_external(idx, frame.r8 as usize, &sched, &observations) {
+        Ok(r) => r,
+        Err(e) => return linux_errno(e.to_linux_errno()),
+    };
+    drop(sched);
+    let mut bytes = alloc::vec![0u8; ready.len() * 16];
+    for (i, event) in ready.iter().enumerate() {
+        bytes[i * 16..i * 16 + 4].copy_from_slice(&event.events.to_ne_bytes());
+        bytes[i * 16 + 8..i * 16 + 16].copy_from_slice(&event.data);
+    }
+    if !bytes.is_empty() && crate::memory::user::copy_to_current(frame.r10, &bytes).is_err() {
+        return linux_errno(14);
+    }
+    ready.len() as u64
+}
