+    lock: AtomicU32::new(0),
+};
+static mut KEYS: [Key; 128] = [Key {
+    generation: 0,
+    live: false,
+    destructor: None,
+}; 128];
+unsafe fn lock_keys() {
+    pthread_mutex_lock(core::ptr::addr_of!(KEY_LOCK) as *mut PthreadMutex);
+}
+unsafe fn unlock_keys() {
+    pthread_mutex_unlock(core::ptr::addr_of!(KEY_LOCK) as *mut PthreadMutex);
