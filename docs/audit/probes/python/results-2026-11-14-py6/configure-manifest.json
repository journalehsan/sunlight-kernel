  "build": "x86_64-pc-linux-gnu",
  "host": "x86_64-unknown-sunlightos",
  "target": "host program ABI; driver x86_64-unknown-none-elf",
  "build_directory": "/tmp/sunlight-py6-cpython/cross-static",
  "override_justifications": {
