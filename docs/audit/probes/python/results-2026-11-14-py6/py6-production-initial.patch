+    }).map_err(|error| {
+        // The syscall has already bounded and decoded its C string; the
+        // remaining InvalidPath is an overlong cwd-plus-component result.
+        if error == sunlight_fs::FsError::InvalidPath { ERR_ERANGE } else { fs_error_raw(error) }
+    })
