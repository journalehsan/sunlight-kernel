 pub static DEVICES: spin::Mutex<DeviceRegistry> = spin::Mutex::new(DeviceRegistry::new());
 
+pub(crate) fn timing_stamp() -> (usize, u64, u64, u64) {
+    x86_64::instructions::interrupts::without_interrupts(|| {
+        let cpu = crate::sched::current_cpu_id();
+        let before = crate::arch::x86_64::interrupts::now_ns();
+        let after = crate::arch::x86_64::interrupts::now_ns();
+        (cpu, before, after, crate::arch::x86_64::interrupts::tsc_hz())
+    })
+}
